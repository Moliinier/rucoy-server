--// AUTO SPAWN
--// ═════════════════════════════════════════════════════════════════════════════

local AutoSpawnData = {
    hasRevived = false,
    lastConnection = nil,
}

local function enableAutoSpawn()
    if Features.AutoSpawn.Connection then return end
    
    local function connectCharacter(character)
        local attributeConnection = character:GetAttributeChangedSignal("Downed"):Connect(function()
            if character:GetAttribute("Downed") and not AutoSpawnData.hasRevived then
                AutoSpawnData.hasRevived = true
                
                pcall(function()
                    ReplicatedStorage.Events.Player.ChangePlayerMode:FireServer(true)
                end)
                
                task.delay(0.5, function() 
                    AutoSpawnData.hasRevived = false 
                end)
            end
        end)
        
        Features.AutoSpawn.Connection = attributeConnection
    end

    if LocalPlayer.Character then 
        connectCharacter(LocalPlayer.Character) 
    end
    
    LocalPlayer.CharacterAdded:Connect(connectCharacter)
    print("✅ Auto Spawn ACTIVADO")
end

local function disableAutoSpawn()
    if Features.AutoSpawn.Connection then
        Features.AutoSpawn.Connection:Disconnect()
        Features.AutoSpawn.Connection = nil
        print("❌ Auto Spawn DESACTIVADO")
    end
end

print("AUTO SPAWN: Funciones cargadas")

