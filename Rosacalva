--// AUTO FARM - VERSIÓN JULIO 2026
--// ═════════════════════════════════════════════════════════════════════════════

local autoFarmConnection = nil

local function startAutoFarm()
    if autoFarmConnection then return end
    
    autoFarmConnection = task.spawn(function()
        while getgenv().farm do
            local tickets = game:GetService("Workspace"):FindFirstChild("Game") 
                and game:GetService("Workspace").Game:FindFirstChild("Effects") 
                and game:GetService("Workspace").Game.Effects:FindFirstChild("Tickets")

            local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
            local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")

            if character and humanoidRootPart then
                -- Auto Respawn si está derribado
                if character:GetAttribute("Downed") then
                    pcall(function()
                        ReplicatedStorage.Events.Player.ChangePlayerMode:FireServer(true)
                    end)
                end

                if tickets then
                    for _, ticket in ipairs(tickets:GetChildren()) do
                        local ticketPart = ticket:FindFirstChild("HumanoidRootPart")
                        if ticketPart then
                            humanoidRootPart.CFrame = ticketPart.CFrame
                            task.wait(0.1)
                        end
                    end
                end
            end
            task.wait(1)
        end
    end)
    
    print("✅ Auto Farm INICIADO")
end

local function stopAutoFarm()
    getgenv().farm = false
    print("❌ Auto Farm DETENIDO")
end

print("AUTO FARM: Funciones cargadas")

