--// EMOTE SPEED
--// ═════════════════════════════════════════════════════════════════════════════

local function applySpeedMultiplier(speedMultiplier)
    for _, obj in pairs(getgc(true)) do
        if typeof(obj) == "table" and rawget(obj, "WalkSpeedMultiplier") ~= nil then
            pcall(function()
                obj.WalkSpeedMultiplier = speedMultiplier
            end)
        end
    end
end

local function enableEmoteSpeed()
    if Features.EmoteSpeed.Connection then return end
    
    local function setupEmoteConnection(character)
        if Features.EmoteSpeed.Connection then 
            Features.EmoteSpeed.Connection:Disconnect() 
        end
        if not character then return end
        
        Features.EmoteSpeed.Connection = character:GetAttributeChangedSignal("State"):Connect(function()
            local state = character:GetAttribute("State")
            if state == "Emoting" then
                applySpeedMultiplier(Features.EmoteSpeed.Speed)
            else
                applySpeedMultiplier(1.5)
            end
        end)
    end
    
    if LocalPlayer.Character then
        setupEmoteConnection(LocalPlayer.Character)
    end
    
    LocalPlayer.CharacterAdded:Connect(setupEmoteConnection)
    print("✅ Emote Speed ACTIVADO - Velocidad: " .. Features.EmoteSpeed.Speed)
end

local function disableEmoteSpeed()
    if Features.EmoteSpeed.Connection then
        Features.EmoteSpeed.Connection:Disconnect()
        Features.EmoteSpeed.Connection = nil
        applySpeedMultiplier(1.5)
        print("❌ Emote Speed DESACTIVADO")
    end
end

