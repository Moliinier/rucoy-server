--// AUTO FARM
--// ═════════════════════════════════════════════════════════════════════════════

local function enableAutoFarm()
    if Features.AutoFarm.Connection then return end
    
    local function startTicketFarm()
        local securityPart = workspace:FindFirstChild("SecurityPart")
        if not securityPart then return end

        Features.AutoFarm.Connection = RunService.Heartbeat:Connect(function()
            local character = LocalPlayer.Character
            if not character or not character:FindFirstChild("HumanoidRootPart") then return end
            local hrp = character.HumanoidRootPart
            
            local tickets = workspace:FindFirstChild("Game") and workspace.Game:FindFirstChild("Effects") and workspace.Game.Effects:FindFirstChild("Tickets")
            
            if character:GetAttribute("Downed") then
                pcall(function()
                    ReplicatedStorage.Events.Player.ChangePlayerMode:FireServer(true)
                end)
                hrp.CFrame = securityPart.CFrame + Vector3.new(0, 3, 0)
                return
            end

            if tickets then
                local activeTickets = tickets:GetChildren()
                if #activeTickets > 0 then
                    local targetTicket = activeTickets[1]
                    local ticketPart = targetTicket:FindFirstChild("HumanoidRootPart") or (targetTicket:IsA("BasePart") and targetTicket)
                    
                    if ticketPart then
                        hrp.CFrame = ticketPart.CFrame + Vector3.new(0, 15, 0)
                        task.wait(0.1)
                        hrp.CFrame = ticketPart.CFrame
                    end
                else
                    hrp.CFrame = securityPart.CFrame + Vector3.new(0, 3, 0)
                end
            end
        end)
    end
    
    startTicketFarm()
    print("✅ Auto Farm ACTIVADO")
end

local function disableAutoFarm()
    if Features.AutoFarm.Connection then
        Features.AutoFarm.Connection:Disconnect()
        Features.AutoFarm.Connection = nil
        print("❌ Auto Farm DESACTIVADO")
    end
end

print("AUTO FARM: Funciones cargadas")

