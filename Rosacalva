--// FULLBRIGHT
--// ═════════════════════════════════════════════════════════════════════════════

local function applyFullBright()
    Lighting.Brightness = 1
    Lighting.Ambient = Color3.new(1, 1, 1)
    Lighting.OutdoorAmbient = Color3.new(1, 1, 1)
    Lighting.ColorShift_Bottom = Color3.new(1, 1, 1)
    Lighting.ColorShift_Top = Color3.new(1, 1, 1)
end

local function restoreLighting()
    Lighting.Brightness = Features.Fullbright.OriginalBrightness
    Lighting.Ambient = Features.Fullbright.OriginalAmbient
    Lighting.OutdoorAmbient = Features.Fullbright.OriginalOutdoorAmbient
end

local function enableFullbright()
    if Features.Fullbright.Connection then return end
    
    applyFullBright()
    
    Features.Fullbright.Connection = RunService.Heartbeat:Connect(function()
        applyFullBright()
    end)
    
    print("✅ Fullbright ACTIVADO")
end

local function disableFullbright()
    if Features.Fullbright.Connection then
        Features.Fullbright.Connection:Disconnect()
        Features.Fullbright.Connection = nil
        restoreLighting()
        print("❌ Fullbright DESACTIVADO")
    end
end

