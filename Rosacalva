--// EMOTE SPEED - VERSIÓN JULIO 2026
--// ═════════════════════════════════════════════════════════════════════════════

local emoteSpeedConnection = nil

local function startEmoteSpeed()
    if emoteSpeedConnection then return end
    
    emoteSpeedConnection = RunService.Heartbeat:Connect(function()
        if getgenv().EmoteSpeedEnabled then
            local character = LocalPlayer.Character
            if character and character:FindFirstChild("Humanoid") then
                if character:GetAttribute("Emoting") == true then
                    character.Humanoid.WalkSpeed = getgenv().EmoteSpeedValue
                end
            end
        end
    end)
    
    print("✅ Emote Speed INICIADO - Velocidad: " .. getgenv().EmoteSpeedValue)
end

local function stopEmoteSpeed()
    if emoteSpeedConnection then
        emoteSpeedConnection:Disconnect()
        emoteSpeedConnection = nil
    end
    getgenv().EmoteSpeedEnabled = false
    print("❌ Emote Speed DETENIDO")
end

print("EMOTE SPEED: Funciones cargadas")

