local autoSpawnConnection = nil

local function startAutoSpawn()
    if autoSpawnConnection then return end
    
    autoSpawnConnection = task.spawn(function()
        while getgenv().autoSpawnActive do
            local character = LocalPlayer.Character
            if character and character:GetAttribute("Downed") then
